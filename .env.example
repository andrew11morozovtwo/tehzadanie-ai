# Application settings
DATABASE_URL=postgresql://user:password@localhost:5432/tehzadanie
SESSION_SECRET=replace_with_a_long_random_value
DEVELOPER_EMAIL=developer@example.com

# ProxyAPI is the AI provider used by the application
PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1
PROXYAPI_KEY=replace_with_proxyapi_key

# Email delivery
RESEND_API_KEY=replace_with_resend_api_key
RESEND_FROM_EMAIL=AI Requirements <no-reply@example.com>
# Development-only preview-verified mode uses its own plain login sender and
# the connected Resend account; it blocks all non-login mail. Do not enable in production.
# EMAIL_AUTH_MAIL_MODE=preview-verified
# EMAIL_AUTH_FROM_EMAIL=login@your-verified-domain.example
# Production auth can explicitly use the same connected Resend account:
# EMAIL_AUTH_TRANSPORT=connector
# EMAIL_AUTH_MAIL_MODE=resend
# EMAIL_AUTH_FROM_EMAIL=login@your-verified-domain.example
# AUTH_PUBLIC_URL=https://your-production-domain.example/

# Optional background audit
AUDIT_ENABLED=false
AUDIT_DEVELOPER_EMAIL=developer@example.com
AUDIT_MODEL=gpt-5.6-terra
AUDIT_MAX_RETRIES=3
AUDIT_MAX_DIALOG_CHARS=60000
ADMIN_AUDIT_TOKEN=replace_with_a_long_random_value