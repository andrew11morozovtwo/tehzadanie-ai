# The audit is disabled unless explicitly enabled.
AUDIT_ENABLED=false
# Must support the configured OpenAI-compatible Chat Completions endpoint.
# gpt-5-codex is rejected by that endpoint as UNSUPPORTED_MODEL.
AUDIT_MODEL=gpt-5.6-terra
AUDIT_MAX_RETRIES=3
AUDIT_MAX_DIALOG_CHARS=60000

# Set these as server secrets before setting AUDIT_ENABLED=true.
AUDIT_DEVELOPER_EMAIL=
ADMIN_AUDIT_TOKEN=